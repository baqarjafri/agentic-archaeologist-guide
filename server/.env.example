# Server settings. For a local run, copy this file to server/.env (gitignored) and fill in the values.
# On Railway these are service variables. Never commit real values.

# Required:
# Gemini API key, used by the default language model and by the voice.
GEMINI_API_KEY=
# Comma-separated access codes for the QR link. Empty leaves the API open to anyone with the URL.
ACCESS_CODES=

# Optional: a missing or blank value keeps the default shown.
# TTS_PROVIDER=gemini                     # or elevenlabs
# GEMINI_TTS_VOICE=Sulafat
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_FALLBACKS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# GEMINI_TTS_PER_MINUTE=10
# ELEVENLABS_API_KEY=                     # required only when TTS_PROVIDER=elevenlabs
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=                            # defaults to GEMINI_API_KEY
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=minimal            # leave commented: a blank value turns reasoning effort off
# RESPELL_NAMES=0                         # 1 uses the pack's pronunciation respellings
# STRICT_CITATIONS=0
# PACK_DIR=../packs/burrell-pilot          # the Dockerfile sets /srv/packs/burrell-pilot
# MODEL_PATH=models/dinov2-small-int8.onnx
# WEB_DIST=../web/dist
# DEMO_DIR=                                # laptop demos only: folder with tour.mp4 and tour.json, served at /demo-media
